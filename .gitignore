{% extends "base.html" %}

{% block title %}
About | Om Ekbote
{% endblock %}

{% block content %}

<section class="bg-slate-950 min-h-screen py-20">

    <div class="max-w-6xl mx-auto px-6">

        <div class="grid lg:grid-cols-2 gap-16 items-center">

            <!-- Left -->

            <div>

                {% if profile.profile_image %}

                <img
                    src="{{ profile.profile_image.url }}"
                    alt="{{ profile.full_name }}"
                    class="rounded-3xl border border-slate-800 shadow-2xl">

                {% endif %}

            </div>

            <!-- Right -->

            <div>

                <span
                    class="text-cyan-400 font-semibold">

                    About Me

                </span>

                <h1
                    class="text-5xl font-black mt-4">

                    {{ profile.full_name }}

                </h1>

                <h2
                    class="text-2xl text-slate-300 mt-4">

                    {{ profile.title }}

                </h2>

                <p
                    class="mt-8 text-slate-400 leading-8">

                    {{ profile.about|default:profile.short_bio }}

                </p>

                <div
                    class="grid grid-cols-2 gap-6 mt-12">

                    <div>

                        <h3 class="font-semibold text-white">

                            Email

                        </h3>

                        <p class="text-slate-400">

                            {{ profile.email }}

                        </p>

                    </div>

                    <div>

                        <h3 class="font-semibold text-white">

                            Location

                        </h3>

                        <p class="text-slate-400">

                            {{ profile.location|default:"Not Added" }}

                        </p>

                    </div>

                    <div>

                        <h3 class="font-semibold text-white">

                            Phone

                        </h3>

                        <p class="text-slate-400">

                            {{ profile.phone|default:"Not Added" }}

                        </p>

                    </div>

                    <div>

                        <h3 class="font-semibold text-white">

                            GitHub

                        </h3>

                        {% if profile.github %}

                        <a
                            href="{{ profile.github }}"
                            target="_blank"
                            class="text-cyan-400">

                            View Profile

                        </a>

                        {% else %}

                        <p class="text-slate-400">

                            Not Added

                        </p>

                        {% endif %}

                    </div>

                </div>

                {% if profile.resume %}

                <a
                    href="{{ profile.resume.url }}"
                    target="_blank"
                    class="inline-block mt-12 bg-cyan-400 text-slate-950 px-8 py-4 rounded-xl font-semibold hover:bg-cyan-300 transition">

                    Download Resume

                </a>

                {% endif %}

            </div>

        </div>

    </div>

</section>

{% endblock %}